# ZeroSum Ledger — environment index: every variable the stack reads, with placeholders only.
# decision: D00-8 — docs/step_00_foundations.md#decisions-and-outputs
#
# Create .env with tools/dev/generate-env.sh (never by copying this file): it replaces each __GENERATE__
# placeholder with `openssl rand -hex 32` and refuses to leave any placeholder behind.
#
# Conventions (D00-8, docs/secrets.md):
#   - project variables use the ZS_ prefix in UPPER_SNAKE_CASE; third-party image and OTel SDK variables
#     keep their standard names;
#   - secret-bearing names end in _PASSWORD, _TOKEN, _TOKENS, _SECRET or _SECRETS;
#   - list values use the comma-separated format of master §5.11 (for example system:token,system:token);
#   - required secrets have no defaults anywhere: Compose uses ${VAR:?message}, Boot configuration has no fallback.
#
# Later steps append their own section below with a purpose comment and a trace comment per variable:
# S03 (API tokens), S05 (webhook secrets and kill switches), S08 (chaos allow flag). Don't add names for them here.

# --- S00: PostgreSQL superuser (D00-4) ---
# Used only by infra/postgres/init.sh on an empty data volume; never by a service, tool or test.
ZS_POSTGRES_SUPERUSER_PASSWORD=__GENERATE__

# --- S00: service database roles (D00-4) ---
# <db>_owner runs Flyway migrations; <db>_app is the runtime role.
ZS_ORDERS_OWNER_DB_PASSWORD=__GENERATE__
ZS_ORDERS_APP_DB_PASSWORD=__GENERATE__
ZS_LEDGER_OWNER_DB_PASSWORD=__GENERATE__
ZS_LEDGER_APP_DB_PASSWORD=__GENERATE__
ZS_INSTRUMENTS_OWNER_DB_PASSWORD=__GENERATE__
ZS_INSTRUMENTS_APP_DB_PASSWORD=__GENERATE__
ZS_FAKEPROVIDERS_OWNER_DB_PASSWORD=__GENERATE__
ZS_FAKEPROVIDERS_APP_DB_PASSWORD=__GENERATE__

# --- S00: cross-database roles (D00-4) ---
# Read-only role for tools/verifier (TB5).
ZS_VERIFIER_DB_PASSWORD=__GENERATE__
# pg_monitor role for query statistics; no table privileges (master §0.3 O12).
ZS_STATS_DB_PASSWORD=__GENERATE__

# --- S00: optional overrides (not secrets; defaults shown) ---
# Database address for services run on the host with bootRun; Compose sets these for service containers.
# ZS_DB_HOST=localhost
# ZS_DB_PORT=5432
# Micrometer OTLP metrics endpoint (D00-6); Compose points service containers at otel-lgtm.
# ZS_OTLP_METRICS_URL=http://localhost:4318/v1/metrics

# --- S03: API tokens (D03-4) ---
# Static bearer tokens per role (master §5.11). Compared with MessageDigest.isEqual against every configured token.
# Writer tokens carry the source system they authenticate as, in the comma-separated system:token format, because
# source.system is derived from the principal and never from a request body (D01-5 rule 8).
ZS_WRITER_TOKENS=trip-simulator:__GENERATE__
# decision: D03-4 — docs/step_03_order_service_outbox.md#decisions-and-outputs
ZS_READER_TOKEN=__GENERATE__
ZS_ADMIN_TOKEN=__GENERATE__

# --- S05: webhook signing (D05-3) ---
# HMAC-SHA256 secrets for provider webhooks, newest first. During rotation both are listed as current,previous:
# fake-providers signs with the first, a receiver accepts either, so the two sides can be restarted independently.
# Read by BOTH sides: fake-providers signs with it and instrument-service verifies with it, so one value, not two.
ZS_WEBHOOK_SECRETS=__GENERATE__
# Where fake-providers delivers signed webhooks (not a secret; the Compose default below is what the stack uses).
# It is the receiver's BASE path: the sender appends the provider, so a delivery lands on /v1/webhooks/fakecard or
# /v1/webhooks/fakebank and the receiver resolves the adapter from the path.
# ZS_WEBHOOK_RECEIVER_URL=http://instrument-service:8083/v1/webhooks

# --- S05: money-movement kill switches (D05-11) ---
# Not secrets, so they are shown as commented defaults rather than generated. Both default to enabled: a stack that
# came up frozen would look healthy and move no money, which is the harder failure to notice. Setting one to false
# freezes that path — attempts are still created, so no order is lost, and they stay in CREATED until it is on again.
# decision: D05-11 — docs/step_05_instruments_fake_providers.md#decisions-and-outputs
# ZS_COLLECTIONS_ENABLED=true
# Freezing payouts refuses every run outright (`payouts_disabled`) rather than leaving attempts waiting: a payout run
# can simply be run again once the switch is on, so there is nothing to preserve.
# ZS_PAYOUTS_ENABLED=true

# --- S05: payout runs (D05-7) ---
# Not secrets; Compose sets the two URLs to the container addresses. Shown here so the knobs are discoverable.
# The freshness threshold is the M10(c) acceptance criterion, not a tuning parameter — raise it and M10(c) changes.
# ZS_PAYOUT_FRESHNESS_THRESHOLD=5s
# ZS_MINIMUM_PAYOUT_MINOR=100
# ZS_ORDER_BASE_URL=http://order-service:8081
# ZS_LEDGER_BASE_URL=http://ledger-service:8082

# --- S01: tests (D01-10, ADR-0009) ---
# Replays a seeded generative test with the seed printed on its ZS-SEED line. Never set in CI.
# ZS_TEST_SEED=<long>
# decision: D01-10 — docs/step_01_domain_contracts.md#decisions-and-outputs
